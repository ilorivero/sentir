+// Inicia o timer que imita o DRDY (chamar no fim do setup()).
+void sentir_fake_begin(void* adcTaskHandle);
+// Ajusta o periodo do timer quando a taxa muda (chamar no loop()).
+void sentir_fake_update();
+#endif
