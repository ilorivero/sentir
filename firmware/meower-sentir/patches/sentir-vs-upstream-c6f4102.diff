+// SPDX-License-Identifier: MIT OR Apache-2.0
+// SENTIR - emulador do ADS1299 para testar o firmware Meower num ESP32-C3 sem a placa.
+#pragma once
+#include <stdint.h>
+#include "sentir_config.h"
+
+#if SENTIR_FAKE_ADC
