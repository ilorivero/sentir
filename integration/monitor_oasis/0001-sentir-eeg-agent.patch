+/// Linha de resumo do EEG (SENTIR) no cartão da estação — ver eeg_agent_client.dart.
+Widget _eegLine(Map<String, dynamic> eeg) {
+  final ok = eeg['error'] == null && eeg['state'] == 'streaming';
+  final sat = (eeg['saturated'] as List?)?.where((e) => e == true).length ?? 0;
+  final parts = <String>[
+    'EEG ${eeg['channels'] ?? '?'}ch',
+    if (eeg['battery_v'] != null) 'bat ${eeg['battery_v']} V',
+    if (eeg['lost'] != null) 'perdas ${eeg['lost']}',
+    if (eeg['sync_ms'] != null) 'sync ±${eeg['sync_ms']} ms',
+    if (eeg['photodiode_latency_ms'] != null) 'tela ${eeg['photodiode_latency_ms']} ms',
+    if (sat > 0) '$sat canal(is) saturado(s)',
+    if (eeg['recording'] == true) 'GRAVANDO',
+    if (eeg['warning'] != null) '${eeg['warning']}',
+    if (eeg['error'] != null) 'erro: ${eeg['error']}',
+  ];
+  return Text(
+    parts.join(' · '),
+    style: TextStyle(color: ok && sat == 0 ? Colors.lightGreenAccent : Colors.orangeAccent, fontSize: 10),
+    overflow: TextOverflow.ellipsis,
+  );
+}
diff --git a/lib/eeg_agent_client.dart b/lib/eeg_agent_client.dart
new file mode 100644
index 0000000..957f84e
--- /dev/null
+++ b/lib/eeg_agent_client.dart
@@ -0,0 +1,216 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+/// Cliente do **agente EEG do SENTIR** (Python, roda nesta mesma estação e recebe a placa
+/// Meower por Wi-Fi via BrainFlow). Ver SENTIR/docs/03-protocolos.md, seção
+/// "App monitor_oasis <-> agente EEG", e CLAUDE.md, seção "EEG (SENTIR)".
+///
+/// Mesmo princípio do [StationClient]: endereço vazio = no-op completo (a estação continua
+/// funcionando exatamente como antes, sem EEG). O agente grava o EEG localmente, em
+/// Parquet; este cliente só:
+///  - responde às sondas de relógio do agente (`tsync`) com o relógio de parede
+///    (`DateTime.now()`), **o mesmo** usado em `exposures.start_timestamp`. Assim o agente
+///    converte cada onset confirmado para o eixo de tempo do EEG;
+///  - avisa início/fim de sessão e cada fase confirmada pelo `presentation_ack`;
+///  - recebe `eeg_status` (qualidade do sinal, bateria, perdas, sincronização, latência do
+///    fotodiodo) e `eeg_preview` (traço reduzido) para repassar ao Painel Central.
+class EegAgentClient {
+  EegAgentClient({required this.address});
+
+  /// host:porta do agente (normalmente `127.0.0.1:8765`). Vazio = desabilitado.
+  final String address;
+
+  WebSocket? _socket;
+  bool _disposed = false;
+  bool _connecting = false;
+  Timer? _reconnectTimer;
+
+  Map<String, dynamic>? _lastStatus;
+  final _statusController = StreamController<Map<String, dynamic>>.broadcast();
+  final _previewController = StreamController<Map<String, dynamic>>.broadcast();
+  final _repliesController = StreamController<Map<String, dynamic>>.broadcast();
+
+  bool get isEnabled => address.trim().isNotEmpty;
+  bool get isConnected => _socket != null;
+
+  /// Último `eeg_status` recebido (null se desabilitado/desconectado).
+  Map<String, dynamic>? get lastStatus => _lastStatus;
+  Stream<Map<String, dynamic>> get status => _statusController.stream;
+  Stream<Map<String, dynamic>> get preview => _previewController.stream;
+
+  Future<void> start() async {
+    if (!isEnabled || _disposed) return;
+    await _connect();
+  }
+
+  Future<void> _connect() async {
+    if (_disposed || !isEnabled || _connecting || _socket != null) return;
+    _connecting = true;
+    try {
+      final socket = await WebSocket.connect('ws://${address.trim()}/ws/app')
+          .timeout(const Duration(seconds: 3));
+      _socket = socket;
+      socket.listen(
+        _handleIncoming,
+        onDone: _handleDisconnect,
+        onError: (_) => _handleDisconnect(),
+        cancelOnError: true,
+      );
+    } catch (_) {
+      _scheduleReconnect();
+    } finally {
+      _connecting = false;
+    }
+  }
+
+  void _handleIncoming(dynamic message) {
+    // t2 o mais cedo possível: instante de chegada da sonda de relógio.
+    final t2 = DateTime.now().microsecondsSinceEpoch;
+    try {
+      final data = jsonDecode(message as String);
+      if (data is! Map) return;
+      final map = data.cast<String, dynamic>();
+      switch (map['type']) {
+        case 'tsync':
+          _send({
+            'type': 'tsync',
+            'seq': map['seq'],
+            't2': t2,
+            't3': DateTime.now().microsecondsSinceEpoch,
+          });
+          break;
+        case 'eeg_status':
+          _lastStatus = map;
+          _statusController.add(map);
+          break;
+        case 'eeg_preview':
+          _previewController.add(map);
+          break;
+        case 'session_started':
+        case 'session_stopped':
+          _repliesController.add(map);
+          break;
+      }
+    } catch (_) {}
+  }
+
+  void _handleDisconnect() {
+    _socket = null;
+    _lastStatus = null;
+    _scheduleReconnect();
+  }
+
+  void _scheduleReconnect() {
+    if (_disposed || !isEnabled) return;
+    _reconnectTimer?.cancel();
+    _reconnectTimer = Timer(const Duration(seconds: 2), _connect);
+  }
+
+  void _send(Map<String, dynamic> message) {
+    final socket = _socket;
+    if (socket == null) return;
+    try {
+      socket.add(jsonEncode(message));
+    } catch (_) {
+      _handleDisconnect();
+    }
+  }
+
+  /// Abre a gravação do EEG para este participante/sessão (pasta própria no agente).
+  void startSession({
+    required String stationId,
+    required String subjectCode,
+    required int sessionId,
+    Map<String, dynamic> protocol = const {},
+  }) {
+    _send({
+      'type': 'session_start',
+      'station_id': stationId,
+      'subject_code': subjectCode,
+      'session_id': sessionId,
+      'protocol': protocol,
+    });
+  }
+
+  /// Fase confirmada pela janela do participante. [startMs] = o mesmo valor gravado em
+  /// `exposures.start_timestamp` (relógio de parede, ms).
+  void phase({
+    required int? exposureId,
+    required String eventType,
+    required String imageName,
+    required int startMs,
+    required int latencyMs,
+    String category = '',
+    double? valence,
+    double? arousal,
+  }) {
+    _send({
+      'type': 'phase',
+      'exposure_id': exposureId ?? -1,
+      'event_type': eventType,
+      'image_name': imageName,
+      'category': category,
+      'valence': valence,
+      'arousal': arousal,
+      'start_ms': startMs,
+      'latency_ms': latencyMs,
+    });
+  }
+
+  void note(String text) {
+    _send({'type': 'note', 'text': text, 't_ms': DateTime.now().millisecondsSinceEpoch});
+  }
+
+  /// Fecha a gravação. Aguarda (até [timeout]) o resumo do agente: pasta, amostras
+  /// gravadas, reajuste de relógio e latência do fotodiodo.
+  Future<Map<String, dynamic>?> stopSession({
+    Duration timeout = const Duration(seconds: 10),
+  }) async {
+    if (!isConnected) return null;
+    final reply = _repliesController.stream
+        .firstWhere((m) => m['type'] == 'session_stopped')
+        .timeout(timeout);
+    _send({'type': 'session_stop'});
+    try {
+      return await reply;
+    } catch (_) {
+      return null;
+    }
+  }
+
+  /// Resumo compacto para o `status` enviado ao Painel Central.
+  Map<String, dynamic>? summaryForCentral() {
+    final s = _lastStatus;
+    if (s == null) return null;
+    final meower = (s['meower'] as Map?)?.cast<String, dynamic>() ?? const {};
+    final clock = (meower['clock'] as Map?)?.cast<String, dynamic>();
+    final signal = (s['signal'] as Map?)?.cast<String, dynamic>() ?? const {};
+    return {
+      'state': meower['state'],
+      'channels': meower['channels'],
+      'battery_v': meower['battery_v'] ?? signal['battery_v'],
+      'lost': meower['lost'],
+      'sync_ms': clock?['uncertainty_ms'],
+      'app_sync_ms': s['app_sync_ms'],
+      'rms_uv': signal['rms_uv'],
+      'saturated': signal['saturated'],
+      'photodiode_latency_ms': s['photodiode_latency_ms'],
+      'recording': s['recording'],
+      'error': s['error'],
+      'warning': s['warning'],
+    };
+  }
+
+  void dispose() {
+    _disposed = true;
+    _reconnectTimer?.cancel();
+    try {
+      _socket?.close();
+    } catch (_) {}
+    _socket = null;
+    _statusController.close();
+    _previewController.close();
+    _repliesController.close();
+  }
+}
